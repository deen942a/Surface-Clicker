{
  "name": "surface-clicker",
  "version": "0.1.4",
  "description": "Surface Clicker - a configurable autoclicker with CPS and duty cycle control",
  "main": "src/main/main.js",
  "author": "",
  "license": "GPL-3.0",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.0",
    "active-win": "^8.2.1",
    "electron-store": "^8.2.0",
    "uiohook-napi": "^1.5.5"
  },
  "build": {
    "appId": "com.surfaceclicker.app",
    "productName": "Surface Clicker",
    "directories": {
      "buildResources": "assets",
      "output": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/SurfaceClicker.ico",
      "target": "nsis"
    },
    "nsis": {
      "artifactName": "Surface-Clicker-Setup.exe"
    },
    "mac": {
      "icon": "assets/SurfaceClicker.icns",
      "target": "dmg"
    },
    "linux": {
      "icon": "assets/SurfaceClicker.png",
      "target": "AppImage"
    }
  }
}